# Cliniko credentials. Never commit a filled-in copy of this file.
# Cliniko API key (My Info > Manage API keys).
CLINIKO_API_KEY=
# Your email, added to the User-Agent as Cliniko asks API clients to identify themselves.
CLINIKO_CONTACT_EMAIL=
# Override of the API base URL. Default: derived from the key, e.g. https://api.uk1.cliniko.com/v1
CLINIKO_BASE_URL=
# Optional: set to true to expose only the read tools.
CLINIKO_READ_ONLY=
# HTTP mode only. Required when the credentials above are set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
