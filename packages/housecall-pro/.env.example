# Housecall Pro credentials. Never commit a filled-in copy of this file.
# Housecall Pro API key (My Apps > API Key Management).
HOUSECALLPRO_API_KEY=
# Override of the API base URL. Default: https://api.housecallpro.com
HOUSECALLPRO_BASE_URL=
# Optional: set to true to expose only the read tools.
HOUSECALLPRO_READ_ONLY=
# HTTP mode only. Required when the credentials above are set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
