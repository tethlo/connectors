{
  "name": "@tethlo/mcp-for-invoice-ninja",
  "version": "0.1.0",
  "description": "Unofficial MCP server for Invoice Ninja (demo): find clients, create and send invoices, record payments and chase late payers from AI agents.",
  "type": "module",
  "license": "MIT",
  "author": "Tethlo (https://tethlo.com)",
  "homepage": "https://github.com/tethlo/connectors/tree/main/packages/invoice-ninja#readme",
  "bugs": {
    "url": "https://github.com/tethlo/connectors/issues"
  },
  "mcpName": "io.github.tethlo/mcp-for-invoice-ninja",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "claude",
    "invoice-ninja",
    "invoicing",
    "payments",
    "demo",
    "tethlo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tethlo/connectors.git",
    "directory": "packages/invoice-ninja"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tethlo-mcp-for-invoice-ninja": "dist/src/stdio.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node src/stdio.ts",
    "start:http": "node src/http.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "eval:claude": "node eval/run-claude.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
