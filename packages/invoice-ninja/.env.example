# Invoice Ninja API token (Settings > Account Management > API Tokens).
# Hosted invoicing.co: API access needs the Pro or Enterprise plan. Self-hosted: free.
INVOICENINJA_API_TOKEN=
# Optional: a self-hosted instance, e.g. https://invoices.example.com. Default: https://invoicing.co
INVOICENINJA_BASE_URL=
# HTTP mode only. Required when INVOICENINJA_API_TOKEN is set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
