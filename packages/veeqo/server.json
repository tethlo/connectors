{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tethlo/mcp-for-veeqo",
  "title": "Tethlo MCP server for Veeqo (unofficial)",
  "description": "Unofficial. Veeqo for AI agents: multichannel orders, stock levels, low stock, order notes.",
  "repository": {
    "url": "https://github.com/tethlo/connectors",
    "source": "github",
    "subfolder": "packages/veeqo"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@tethlo/mcp-for-veeqo",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VEEQO_API_KEY",
          "description": "Veeqo API key.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "VEEQO_BASE_URL",
          "description": "Override of the API base URL. Default: https://api.veeqo.com",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
