# Healthchecks.io project API key (Project Settings > API Access).
# Use a read-write key for all tools; a read-only key only allows the read tools.
HEALTHCHECKS_API_KEY=
# Optional: a self-hosted Healthchecks instance. Default: https://healthchecks.io
HEALTHCHECKS_BASE_URL=
# HTTP mode only. Required when HEALTHCHECKS_API_KEY is set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
