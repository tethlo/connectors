# Deputy credentials. Never commit a filled-in copy of this file.
# Your Deputy install, e.g. yourcompany.na.deputy.com. In remote mode this is a server setting.
DEPUTY_HOST=
# Deputy permanent access token.
DEPUTY_ACCESS_TOKEN=
# Override of the API base URL. Default: https://<DEPUTY_HOST>/api/v1
DEPUTY_BASE_URL=
# Optional: set to true to expose only the read tools.
DEPUTY_READ_ONLY=
# HTTP mode only. Required when the credentials above are set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
