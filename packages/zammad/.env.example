# Zammad credentials. Never commit a filled-in copy of this file.
# Your Zammad address, e.g. https://support.example.com. In remote mode this is a server setting.
ZAMMAD_URL=
# Zammad access token (Profile > Token Access, permission ticket.agent).
ZAMMAD_TOKEN=
# Optional: set to true to expose only the read tools.
ZAMMAD_READ_ONLY=
# HTTP mode only. Required when the credentials above are set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
