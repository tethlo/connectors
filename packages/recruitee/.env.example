# Recruitee credentials. Never commit a filled-in copy of this file.
# Recruitee company id (shown with the personal API token).
RECRUITEE_COMPANY_ID=
# Recruitee personal API token.
RECRUITEE_API_TOKEN=
# Override of the API base URL. Default: https://api.recruitee.com
RECRUITEE_BASE_URL=
# Optional: set to true to expose only the read tools.
RECRUITEE_READ_ONLY=
# HTTP mode only. Required when the credentials above are set on a remote server:
# clients must then send "Authorization: Bearer <MCP_ACCESS_TOKEN>". Use a long random value.
MCP_ACCESS_TOKEN=
PORT=3000
HOST=127.0.0.1
# Optional, only for `npm run eval:claude`
ANTHROPIC_API_KEY=
