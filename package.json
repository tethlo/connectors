{
  "name": "tethlo-connectors",
  "private": true,
  "type": "module",
  "description": "Tethlo's open-source MCP servers (unofficial connectors and demos) for B2B SaaS APIs.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check"
  }
}
